.chart-shell {
  position: relative;
  width: 100%;
  height: 680rpx;
}

.chart-tooltip { position: absolute; top: 16rpx; right: 16rpx; z-index: 2; min-width: 210rpx; padding: 12rpx 14rpx; border: 1rpx solid var(--color-line); background: rgba(11, 23, 40, .96); color: var(--color-text); font-size: 18rpx; pointer-events: none; }
.chart-tooltip text { display: block; font-variant-numeric: tabular-nums; }
.tooltip-date { margin-bottom: 7rpx; color: var(--color-text-secondary); }
.tooltip-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 4rpx 12rpx; }
.tooltip-volume { grid-column: 1 / -1; color: var(--color-text-secondary); }
.tooltip-nav { color: var(--color-brand); font-weight: 650; }

.finance-chart {
  width: 100%;
  height: 100%;
}
