/* M12 Design System: 4rpx baseline, restrained financial-product palette. */
page {
  --color-brand: #30c7e8;
  --color-brand-soft: #102a3b;
  --color-rise: #ff626b;
  --color-fall: #2dd4a0;
  --color-neutral: #8a97aa;
  --color-text: #edf3fb;
  --color-text-secondary: #a7b3c5;
  --color-text-tertiary: #738198;
  --color-bg: #07111f;
  --color-surface: #0b1728;
  --color-surface-raised: #101d30;
  --color-line: #203047;
  --color-warning: #e9b75b;
  --color-warning-bg: #2a2418;
  --radius-control: 6rpx;
  --radius-card: 6rpx;
  --space-1: 8rpx;
  --space-2: 12rpx;
  --space-3: 16rpx;
  --space-4: 20rpx;
  --space-5: 24rpx;
  --space-6: 32rpx;
  min-height: 100%;
  background: var(--color-bg);
  color: var(--color-text);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", sans-serif;
  font-size: 28rpx;
  letter-spacing: 0;
}

.data-number {
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum";
}

view,
text,
button,
input,
navigator,
scroll-view {
  box-sizing: border-box;
}

button {
  letter-spacing: 0;
}

.page-shell {
  min-height: 100vh;
  padding: 24rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
}

.page-header {
  padding: 12rpx 0 28rpx;
}

.page-title {
  display: block;
  overflow-wrap: anywhere;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.25;
}

.page-subtitle {
  display: block;
  margin-top: 8rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  line-height: 1.5;
}

.section-block {
  margin-top: 40rpx;
}

.section-head {
  display: flex;
  min-height: 48rpx;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.section-title {
  min-width: 0;
  margin: 0;
  font-size: 30rpx;
  font-weight: 650;
  line-height: 1.35;
}

.section-title::before {
  display: inline-block;
  width: 6rpx;
  height: 6rpx;
  margin-right: 12rpx;
  border-radius: 0;
  background: var(--color-brand);
  content: '';
  vertical-align: 5rpx;
}

.section-link {
  flex-shrink: 0;
  color: var(--color-brand);
  font-size: 24rpx;
}

.surface {
  background: var(--color-surface);
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-card);
}

.divider-list {
  background: var(--color-surface);
  border-top: 1rpx solid var(--color-line);
  border-bottom: 1rpx solid var(--color-line);
}

.meta-text,
.source-text,
.time-text {
  color: var(--color-text-tertiary);
  font-size: 22rpx;
  line-height: 1.45;
}

.rise {
  color: var(--color-rise) !important;
}

.fall {
  color: var(--color-fall) !important;
}

.flat {
  color: var(--color-neutral) !important;
}

.status-pill {
  display: inline-flex;
  min-height: 40rpx;
  align-items: center;
  padding: 0 14rpx;
  border-radius: var(--radius-control);
  border: 1rpx solid var(--color-line);
  background: var(--color-surface-raised);
  color: var(--color-text-secondary);
  font-size: 21rpx;
}

.status-pill.warning {
  background: var(--color-warning-bg);
  color: var(--color-warning);
}

.primary-button,
.secondary-button,
.text-button,
.icon-button,
.retry-button {
  margin: 0;
  border-radius: var(--radius-control);
  font-size: 25rpx;
}

.primary-button {
  background: var(--color-brand);
  color: #041019;
  font-weight: 650;
}

.secondary-button,
.retry-button {
  border: 1rpx solid var(--color-line);
  background: var(--color-surface-raised);
  color: var(--color-text);
}

.text-button {
  padding: 0;
  background: transparent;
  color: var(--color-brand);
  line-height: 1.6;
}

.primary-button::after,
.secondary-button::after,
.text-button::after,
.icon-button::after,
.retry-button::after {
  border: 0;
}

.retry-button {
  min-width: 180rpx;
  margin-top: 24rpx;
  line-height: 68rpx;
}

.notice-bar {
  padding: 12rpx 18rpx;
  border-left: 3rpx solid #d69e2e;
  background: var(--color-warning-bg);
  color: var(--color-warning);
  font-size: 23rpx;
  line-height: 1.5;
}

.segmented-scroll {
  width: 100%;
  white-space: nowrap;
}

.segmented-control {
  display: inline-flex;
  min-height: 64rpx;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx;
  border-radius: var(--radius-control);
  border: 1rpx solid var(--color-line);
  background: #081321;
}

.segment-button {
  min-width: 92rpx;
  margin: 0;
  padding: 0 20rpx;
  border: 0;
  border-radius: 4rpx;
  background: transparent;
  color: var(--color-text-secondary);
  font-size: 23rpx;
  line-height: 52rpx;
}

.segment-button::after {
  border: 0;
}

.segment-button.active {
  background: var(--color-brand-soft);
  color: var(--color-brand);
  font-weight: 650;
  box-shadow: none;
}

.skeleton-stack {
  padding: 24rpx 0;
}

.skeleton-line {
  height: 24rpx;
  margin-bottom: 18rpx;
  border-radius: 4rpx;
  background: linear-gradient(90deg, #142238 25%, #1c2d45 50%, #142238 75%);
  background-size: 200% 100%;
  animation: skeleton-wave 1.4s ease-in-out infinite;
}

.skeleton-line.short {
  width: 42%;
}

.skeleton-line.medium {
  width: 72%;
}

@keyframes skeleton-wave {
  from { background-position: 200% 0; }
  to { background-position: -200% 0; }
}

.page-enter {
  animation: page-enter 180ms ease-out both;
}

@keyframes page-enter {
  from { opacity: 0; transform: translateY(8rpx); }
  to { opacity: 1; transform: translateY(0); }
}
