.fund-page { padding-top: 18rpx; }
.fund-header, .fund-item-head, .search-row, .fund-status-row, .position-line { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.refresh-button { min-width: 112rpx; padding: 0 24rpx; font-size: 24rpx; line-height: 62rpx; }
.search-form { width: 100%; }
.search-bar { display: grid; width: 100%; height: 76rpx; overflow: hidden; border: 1rpx solid var(--color-line); border-radius: var(--radius-control); background: var(--color-surface); box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, .025); grid-template-columns: minmax(0, 1fr) 128rpx; }
.search-bar input { width: 100%; height: 74rpx; min-width: 0; padding: 0 22rpx; color: var(--color-text); font-size: 26rpx; line-height: 74rpx; }
.search-placeholder { color: var(--color-text-tertiary); }
.search-bar button { width: 128rpx; height: 74rpx; margin: 0; padding: 0; border-radius: 0; background: var(--color-brand-soft); color: var(--color-brand); font-size: 25rpx; font-weight: 650; line-height: 74rpx; white-space: nowrap; }
.search-bar button::after { border: 0; }
.search-section { margin-top: 24rpx; padding: 22rpx 24rpx; }
.search-results { border-top: 1rpx solid var(--color-line); }
.search-row { min-height: 104rpx; border-bottom: 1rpx solid var(--color-line); }
.search-row:last-child { border-bottom: 0; }
.favorite-button { flex-shrink: 0; font-size: 23rpx; }
.watchlist-head { margin-top: 38rpx; }
.watchlist { display: flex; flex-direction: column; gap: 16rpx; }
.fund-item { position: relative; padding: 24rpx; border-top: 2rpx solid var(--color-brand); box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, .025); }
.fund-identity { min-width: 0; flex: 1; }
.fund-name, .fund-meta, .value-label, .value-number, .value-date { display: block; }
.fund-name { overflow: hidden; font-size: 29rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.fund-meta { margin-top: 7rpx; color: var(--color-text-tertiary); font-size: 21rpx; }
.remove-button { width: 54rpx; height: 54rpx; flex-shrink: 0; padding: 0; border: 0; background: transparent; color: var(--color-text-tertiary); font-size: 36rpx; line-height: 54rpx; }
.fund-values { display: grid; margin-top: 22rpx; padding: 20rpx 0; border-top: 1rpx solid var(--color-line); border-bottom: 1rpx solid var(--color-line); grid-template-columns: repeat(2, minmax(0, 1fr)); }
.fund-values > view { min-width: 0; padding: 0 18rpx; }
.fund-values > view:first-child { padding-left: 0; border-right: 1rpx solid var(--color-line); }
.value-label { color: var(--color-text-secondary); font-size: 22rpx; }
.value-number { margin-top: 9rpx; overflow: hidden; font-size: 40rpx; font-weight: 750; text-overflow: ellipsis; white-space: nowrap; font-variant-numeric: tabular-nums; }
.value-date { margin-top: 7rpx; color: var(--color-text-tertiary); font-size: 21rpx; }
.fund-status-row { margin-top: 14rpx; color: var(--color-text-tertiary); font-size: 21rpx; }
.fund-market-tag { padding: 4rpx 8rpx; border: 1rpx solid var(--color-line); background: var(--color-surface-raised); color: var(--color-text-secondary); font-size: 18rpx; }
.warning-text { color: var(--color-warning); }
.position-line { margin-top: 18rpx; padding-top: 16rpx; border-top: 1rpx solid var(--color-line); font-size: 23rpx; }
.position-line > text:first-child { margin-right: auto; color: var(--color-text-secondary); }
.position-profit, .position-rate { flex-shrink: 0; font-weight: 650; }
