APP_ENV=development
APP_NAME=ai-finance-wechat-assistant
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://finance:finance@postgres:5432/finance
REDIS_URL=redis://redis:6379/0
ADMIN_TOKEN=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
WECOM_WEBHOOK_URL=
COLLECT_INTERVAL_SECONDS=60
MAX_TASK_RETRIES=3
PUSH_MIN_IMPORTANCE=4
TIMEZONE=Asia/Shanghai
ENABLE_CRAWLER=false
ENABLE_AI=false
ENABLE_PUSH=false
NOTIFICATION_MERGE_WINDOW_MINUTES=15
NEWS_SOURCE_NAME=cnbc
NEWS_SOURCE_URL=https://www.cnbc.com/id/100003114/device/rss/rss.html
ENABLE_CHINANEWS=true
CHINANEWS_RSS_URL=https://www.chinanews.com.cn/rss/finance.xml
ENABLE_TMTPOST=false
TMTPOST_RSS_URL=https://www.tmtpost.com/rss.xml
ENABLE_EASTMONEY=true
EASTMONEY_RSS_URL=https://rss.eastmoney.com/rss/finance.xml
ENABLE_CLS=true
CLS_RSS_URL=https://www.cls.cn/telegraph
ENABLE_STCN=true
STCN_RSS_URL=https://www.stcn.com/rss/finance.xml
ENABLE_WALLSTREETCN=true
WALLSTREETCN_RSS_URL=https://wallstreetcn.com/rss/global
RSS_REQUEST_TIMEOUT_SECONDS=20
ENABLE_JIN10=false
ENABLE_CNBC_FALLBACK=true
JIN10_SECRET_KEY=
JIN10_BASE_URL=https://open-data-api.jin10.com/data-api
JIN10_MARKET_CATEGORY=1
JIN10_REQUEST_TIMEOUT_SECONDS=15
MAX_ITEMS_PER_CYCLE=3
NOTIFICATION_USER_ID=00000000-0000-0000-0000-000000000001
PUSH_DESTINATION=personal-wecom
QUIET_HOURS_START=22:30
QUIET_HOURS_END=07:30
MARKET_DATA_SOURCE_URL=https://query1.finance.yahoo.com
MARKET_CACHE_TTL_SECONDS=60
MARKET_REQUEST_TIMEOUT_SECONDS=5
MARKET_HISTORY_CACHE_TTL_SECONDS=900
TUSHARE_TOKEN=
TUSHARE_BASE_URL=https://api.tushare.pro
FUND_REQUEST_TIMEOUT_SECONDS=15
FUND_USER_ID=00000000-0000-0000-0000-000000000001
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ENABLE_EXPERIMENTAL_FUND_VALUATION=true
ENABLE_EXPERIMENTAL_SINA_FUND_VALUATION=false
ENABLE_EXPERIMENTAL_EASTMONEY_FUND_DATA=false
FUND_VALUATION_BASE_URL=https://fundcomapi.tiantianfunds.com
SINA_FUND_VALUATION_BASE_URL=https://stock.finance.sina.com.cn/fundInfo/api/openapi.php
EASTMONEY_FUND_TREND_BASE_URL=https://fund.eastmoney.com/pingzhongdata
EASTMONEY_FUND_MOBILE_BASE_URL=https://fundmobapi.eastmoney.com
FUND_VALUATION_REQUEST_TIMEOUT_SECONDS=15
FUND_VALUATION_CACHE_TTL_SECONDS=20
FUND_VALUATION_STALE_SECONDS=600
FUND_CATALOG_CACHE_TTL_SECONDS=21600
FUND_NAV_CACHE_TTL_SECONDS=1800
FUND_NAV_HISTORY_CACHE_TTL_SECONDS=1800
FUND_HOLDINGS_CACHE_TTL_SECONDS=60
